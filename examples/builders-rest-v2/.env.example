# Configure values ONLY in your project's server-side Secrets interface.
# This template contains no credential and never enables sending by itself.
APP_ORIGIN=https://YOUR_APP.example
WAFLY_OWNER_USER_ID=YOUR_AUTHENTICATED_USER_UUID
WAFLY_DISPATCH_ENABLED=false
WAFLY_CLIENT_TOKEN=
WAFLY_INSTANCE_ID=
WAFLY_INSTANCE_TOKEN=
# Only your own authorized test number, digits including country/area code.
WAFLY_TEST_PHONE=
# Use existing platform keys; do not create or rotate credentials for this kit.
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEYS and SUPABASE_SECRET_KEYS are server envs.
# The JSON maps use the "default" key. Singular *_KEY variables work locally.
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are fallback only.
# Never expose the secret/service-role key in browser, VITE_ or NEXT_PUBLIC_.
