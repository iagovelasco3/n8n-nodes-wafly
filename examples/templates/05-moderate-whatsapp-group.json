      },
      "id": "wafly-welcome",
      "name": "Welcome the new member",
      "type": "n8n-nodes-wafly.wafly",
      "typeVersion": 1,
      "position": [
        820,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
