{
  "name": "n8n-nodes-wafly",
  "version": "1.6.1",
  "description": "n8n community node for the Wafly WhatsApp Bridge API — send messages, manage groups and configure webhooks",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "wafly",
    "whatsapp",
    "whatsapp-api",
    "messaging"
  ],
  "license": "MIT",
  "homepage": "https://wafly.io/?utm_source=npm&utm_medium=community_node&utm_campaign=n8n_integration&utm_content=package_homepage",
  "author": {
    "name": "Wafly",
    "email": "contato@wafly.com.br"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iagovelasco3/n8n-nodes-wafly.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build && npm run check:generated && npm run lint && node --test tests/*.test.cjs",
    "gen:ops": "node scripts/gen-operations.mjs",
    "prebuild": "node scripts/gen-operations.mjs",
    "sync:api": "node scripts/sync-api.mjs",
    "check:generated": "node scripts/gen-operations.mjs --check"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WaflyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Wafly/Wafly.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.53.4",
    "@types/node": "^22.20.5",
    "eslint": "^9.29.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "prettier": "^2.7.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
